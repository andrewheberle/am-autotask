{{- /*
Built-in ticket templates. A templates file given with --templates may
redefine any of these blocks; the rest keep the definitions here.
*/ -}}

{{define "ticket.title" -}}
{{with .CommonAnnotations.summary}}{{.}}{{else}}{{default (default "Alert group" .CommonLabels.alertname) .GroupLabels.alertname}}{{end}}
{{- with labels .GroupLabels "alertname"}}{{if ne . "{}"}} {{.}}{{end}}{{end}}
{{- end}}

{{define "ticket.description" -}}
{{with .CommonAnnotations.summary}}{{.}}
{{end -}}
{{with .CommonAnnotations.description}}{{.}}
{{end -}}
{{if or .CommonAnnotations.summary .CommonAnnotations.description}}
{{end -}}
{{with trim .CommonAnnotations.runbook_url}}Runbook: {{.}}

{{end -}}
Group labels: {{labels .GroupLabels}}
{{with .AlertmanagerURL}}Alertmanager: {{.}}
{{end}}
Firing ({{len .Alerts}}):
{{range .Alerts -}}
- {{.Name}} {{labels .Labels $.GroupLabels "alertname"}}
{{- with .Annotations.summary}}
  {{.}}
{{- end}}
{{- with trim .Annotations.runbook_url}}{{if ne . (trim $.CommonAnnotations.runbook_url)}}
  Runbook: {{.}}
{{- end}}{{end}}
  Started: {{time .StartsAt}}
{{- with .GeneratorURL}}
  Source: {{.}}
{{- end}}
{{end -}}
{{end}}

{{define "note.title" -}}
{{default (default "Alert group" .CommonLabels.alertname) .GroupLabels.alertname}}{{if .GroupResolved}} resolved{{end}}: {{len .Fired}} firing, {{len .Resolved}} resolved
{{- end}}

{{define "note.description" -}}
{{if .Fired}}Firing ({{len .Fired}}):
{{range .Fired -}}
- {{.Name}} {{labels .Labels $.GroupLabels "alertname"}}
{{- with .Annotations.summary}}
  {{.}}
{{- end}}
{{- with trim .Annotations.runbook_url}}{{if ne . (trim $.CommonAnnotations.runbook_url)}}
  Runbook: {{.}}
{{- end}}{{end}}
  Started: {{time .StartsAt}}
{{- with .GeneratorURL}}
  Source: {{.}}
{{- end}}
{{end -}}
{{end -}}
{{if .Resolved}}{{if .Fired}}
{{end}}Resolved ({{len .Resolved}}):
{{range .Resolved -}}
- {{.Name}} {{labels .Labels $.GroupLabels "alertname"}}
{{- with .Annotations.summary}}
  {{.}}
{{- end}}
  Started: {{time .StartsAt}}
{{- if not .EndsAt.IsZero}}
  Ended: {{time .EndsAt}}
{{- end}}
{{- with .GeneratorURL}}
  Source: {{.}}
{{- end}}
{{end -}}
{{end -}}
{{end}}
