{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
		"github>andrewheberle/renovate-config#v1.1.0",
    "customManagers:githubActionsVersions"
  ],
  "packageRules": [
    {
      "description": "deb-s3 only publishes .deb packages in the release workflow, so updates must not trigger a release",
      "matchDatasources": ["rubygems"],
      "matchPackageNames": ["deb-s3"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    }
  ]
}
